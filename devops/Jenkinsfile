/*
  Practica 2 - versión mejorada (solución rápida)
*/

pipeline {
  agent any

  stages {
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "Build: ${env.BUILD_NUMBER}"
      }
    }

    stage('CI Lint') {
      agent {
        docker {
          image 'python:3.10-slim'
          args '-u root:root -v /var/jenkins_home/.cache/pip:/root/.cache/pip'
        }
      }
      steps {
        sh 'python --version'
        // pip y herramientas de lint (agrupadas)
        sh 'pip install --upgrade pip'
        sh 'pip install flake8 pytest || true'
        // instalar make de forma no interactiva y limpiar listas
        sh 'export DEBIAN_FRONTEND=noninteractive && apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*'
        // ejecutar lint (fallará si hay errores de estilo)
        sh 'make lint'
      }
    }

    stage('CI Test') {
      agent {
        docker {
          image 'python:3.10-slim'
          args '-u root:root -v /var/jenkins_home/.cache/pip:/root/.cache/pip -v /var/jenkins_home/.cache/pytest:/root/.cache/pytest'
        }
      }
      steps {
        sh 'python --version'
        sh 'pip install --upgrade pip'
        // instalar dependencias y herramientas necesarias
        sh 'pip install -r requirements.txt || true'
        sh 'pip install pytest || true'
        // instalar make (no persiste entre stages)
        sh 'export DEBIAN_FRONTEND=noninteractive && apt-get update && apt-get install -y --no-install-recommends make && rm -rf /var/lib/apt/lists/*'
        // ejecutar tests
        sh 'make test'
      }
    }
  }
}
