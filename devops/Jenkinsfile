/*
  Practica 2
*/

pipeline {  
  agent any
  
  stages {    
    stage('Info') {
      steps {
        echo "Job: ${env.JOB_NAME}"
        echo "build: ${env.BUILD_NUMBER}"
      }      
    }
    stage('Test') {
      agent {
        docker {
          image 'python:3.6-slim'
          args '-u root:root'
        }
      }
      steps {
        sh 'python --version'
        sh 'pytest -q'
      }
    }
  }
}
